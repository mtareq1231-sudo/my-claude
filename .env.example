# انسخ الملف ده باسم .env واملأ القيم من لوحة تحكم Meta
# cp .env.example .env

# ---- إعدادات عامة ----
PORT=3000

# أي كلمة سر من اختيارك — بتكتبها هنا وبتكتب نفسها في خانة Verify Token
# وانت بتضيف الـ webhook في developers.facebook.com
META_VERIFY_TOKEN=

# App Secret من: My Apps > التطبيق > Settings > Basic
META_APP_SECRET=

# ---- واتساب (WhatsApp Cloud API) ----
# من: WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=

# ---- ماسنجر + انستجرام ----
# Page Access Token من: Messenger > Settings > Access Tokens
# نفس التوكن بيشتغل للانستجرام لو الحساب مربوط بالصفحة
FB_PAGE_TOKEN=
# لو الانستجرام بتوكن منفصل حطه هنا، غير كده سيبه فاضي
IG_TOKEN=

# ---- سلوك الرسالة ----
# التأخير قبل إرسال الرد (بالثواني)
WELCOME_DELAY_SECONDS=60

# لو الرسالة اتأخرت أكتر من كده لأي سبب، يتم إلغاؤها بدل إرسالها متأخرة
MAX_LATE_SECONDS=600

# 0 = العميل يستلم الرسالة مرة واحدة بس مدى الحياة
# غيّرها لـ 30 مثلاً لو عايز يستلمها تاني بعد 30 يوم
RE_WELCOME_AFTER_DAYS=0
